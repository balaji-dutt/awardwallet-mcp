{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "awardwallet-mcp-auth",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    // Must equal the connector URL entered in Claude, path included: every token is bound to it.
    "MCP_RESOURCE": "https://awardwallet-mcp-auth.balaji-dutt-homelab.workers.dev/mcp",
    "UPSTREAM_MCP_URL": "https://awardwallet-mcp.fly.dev/mcp",
    "ALLOWED_GITHUB_LOGIN": "balaji-dutt"
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "bb843b5e014b44b5a0a74e182725cebe"
    }
  ],
  "observability": {
    "enabled": true
  },
  "dev": {
    "port": 8788
  },
  "secrets": {
    "required": [
      "GITHUB_CLIENT_ID",
      "GITHUB_CLIENT_SECRET",
      "COOKIE_ENCRYPTION_KEY",
      "PROXY_SHARED_SECRET"
    ]
  }
}
